# Copy to .env for local development. Do not use these local credentials in production.
POSTGRES_USER=nagar
POSTGRES_PASSWORD=nagar_local_only
POSTGRES_DB=nagar
DATABASE_URL=postgresql://nagar:nagar_local_only@localhost:5432/nagar?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development

# NagarHub Git storage (relative to the monorepo root; keep outside tracked source)
NAGAR_GIT_ROOT=data/git
NAGAR_GIT_BASE_URL=http://localhost:4000/git
NAGAR_API_INTERNAL=http://localhost:4000

# Required to store webhook secrets encrypted (generate with: openssl rand -hex 32).
# Keep this stable and private; losing it requires every repository webhook to be re-created.
NAGAR_WEBHOOK_ENCRYPTION_KEY=replace-with-64-hex-characters
